{
  "name": "neportal",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @neportal/database exec prisma generate",
    "db:push": "pnpm --filter @neportal/database exec prisma db push",
    "db:migrate": "pnpm --filter @neportal/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @neportal/database exec prisma db seed",
    "db:studio": "pnpm --filter @neportal/database exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  }
}
