{
  "name": "neportal",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "db:generate": "node scripts/prisma-with-root-env.mjs generate",
    "db:push": "node scripts/prisma-with-root-env.mjs db push",
    "db:migrate": "node scripts/prisma-with-root-env.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma-with-root-env.mjs migrate deploy",
    "db:seed": "node scripts/prisma-with-root-env.mjs db seed",
    "db:studio": "node scripts/prisma-with-root-env.mjs studio",
    "users:aliases:backfill": "pnpm --filter @neportal/shared build && dotenv -e .env -- pnpm --filter @neportal/database aliases:backfill",
    "projectId:nulls": "dotenv -e .env -- pnpm --filter @neportal/database projectId:nulls",
    "projectId:backfill": "dotenv -e .env -- pnpm --filter @neportal/database projectId:backfill",
    "note:projectId:linked": "dotenv -e .env -- pnpm --filter @neportal/database note:projectId:linked",
    "note:projectId:nullify": "dotenv -e .env -- pnpm --filter @neportal/database note:projectId:nullify"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20"
  }
}
