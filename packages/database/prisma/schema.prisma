generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum EntityStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum UserRole {
  OWNER
  MANAGER
  EMPLOYEE
  ACCOUNTANT
}

enum ProjectRole {
  MANAGER
  MEMBER
  VIEWER
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  DONE
  CANCELLED
}

enum NoteSource {
  WEB
  TELEGRAM_TEXT
  TELEGRAM_VOICE
}

enum TaskCommentSource {
  WEB
  TELEGRAM_TEXT
  TELEGRAM_VOICE
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

enum BudgetExpenseStatus {
  PENDING_RECEIPT
  APPROVED
}

enum ExpenseSource {
  WEB
  TELEGRAM_TEXT
  TELEGRAM_VOICE
}

enum AbsenceType {
  SICK_LEAVE
  VACATION
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReminderStatus {
  SCHEDULED
  SENT
  CANCELLED
}

enum TaskNotificationType {
  TASK_ASSIGNED
  TASK_DEADLINE_TOMORROW
  TASK_OVERDUE_ASSIGNEE
  TASK_OVERDUE_CREATOR
  TASK_COMPLETED_CREATOR
  TASK_CANCELLED_CREATOR
  TASK_STARTED_CREATOR
}

enum TaskTransferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum AbsenceNotificationType {
  ABSENCE_AFFECTED_TASKS_EMPLOYEE
  ABSENCE_AFFECTED_TASK_CREATOR
  ABSENCE_TASK_DELEGATED_CREATOR
}

enum NotificationBindingType {
  NEW_TASK
  TASK_TRANSFER
  TASK_COMMENT
  TASK_MENTION
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model Organization {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  status    EntityStatus   @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  users          User[]
  projects       Project[]
  tasks          Task[]
  notes          Note[]
  budgets        Budget[]
  budgetAccess   BudgetAccess[]
  budgetExpenses BudgetExpense[]
  absences              Absence[]
  reminders             Reminder[]
  taskNotificationLogs        TaskNotificationLog[]
  taskComments                TaskComment[]
  taskCommentMentions         TaskCommentMention[]
  taskTransfers               TaskTransfer[]
  absenceNotificationLogs     AbsenceNotificationLog[]
  notificationBindings        NotificationMessageBinding[]
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  telegramId       String? @unique
  telegramUsername String?
  email            String?
  phone      String?
  fullName   String
  systemAliases String?
  role       UserRole
  status     EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProjects  Project[]       @relation("ProjectCreator")
  projectMembers   ProjectMember[]
  createdTasks     Task[]          @relation("TaskCreator")
  assignedTasks    Task[]          @relation("TaskAssignee")
  notes            Note[]
  createdBudgets   Budget[]        @relation("BudgetCreator")
  archivedBudgets  Budget[]        @relation("BudgetArchivedBy")
  budgetAccess     BudgetAccess[]  @relation("BudgetAccessUser")
  budgetAccessCreated BudgetAccess[] @relation("BudgetAccessCreatedBy")
  budgetExpenses   BudgetExpense[] @relation("ExpenseUser")
  attachments      BudgetExpenseAttachment[]
  absences               Absence[]
  cancelledAbsences      Absence[]                 @relation("AbsenceCancelledBy")
  reminders              Reminder[]
  taskNotificationLogs   TaskNotificationLog[]
  taskComments           TaskComment[]
  mentionsReceived       TaskCommentMention[] @relation("MentionedUser")
  mentionsRequested      TaskCommentMention[] @relation("RequestedBy")
  transfersFrom              TaskTransfer[]            @relation("TransferFromUser")
  transfersTo                TaskTransfer[]            @relation("TransferToUser")
  transfersRequested         TaskTransfer[]            @relation("TransferRequestedBy")
  absenceNotificationLogs    AbsenceNotificationLog[]

  @@unique([organizationId, telegramUsername])
  @@index([organizationId])
  @@index([telegramId])
}

model Project {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      EntityStatus @default(ACTIVE)

  createdById String
  createdBy   User         @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members ProjectMember[]
  tasks   Task[]
  notes   Note[]
  budgets Budget[]

  @@index([organizationId])
  @@index([createdById])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  createdAt DateTime    @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title       String
  description String?

  creatorId String
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  status TaskStatus @default(NEW)

  deadlineAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?

  completionResult   String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reminders               Reminder[]
  notificationLogs        TaskNotificationLog[]
  comments                TaskComment[]
  commentMentions         TaskCommentMention[]
  transfers               TaskTransfer[]
  absenceNotificationLogs AbsenceNotificationLog[]
  notificationBindings    NotificationMessageBinding[]

  @@index([organizationId])
  @@index([projectId])
  @@index([creatorId])
  @@index([assigneeId])
  @@index([deadlineAt])
}

model TaskTransfer {
  id               String             @id @default(cuid())
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUserId       String
  fromUser         User               @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId         String
  toUser           User               @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: Restrict)
  requestedById    String
  requestedBy      User               @relation("TransferRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  absenceId        String?
  absence          Absence?           @relation(fields: [absenceId], references: [id], onDelete: SetNull)
  comment          String?
  status           TaskTransferStatus @default(PENDING)
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  decidedAt        DateTime?
  updatedAt        DateTime           @updatedAt

  @@index([organizationId])
  @@index([taskId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([requestedById])
  @@index([absenceId])
  @@index([status])
  @@index([createdAt])
}

model TaskComment {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId       String
  author         User              @relation(fields: [authorId], references: [id], onDelete: Restrict)
  text           String
  source         TaskCommentSource @default(WEB)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  mentions       TaskCommentMention[]

  @@index([organizationId])
  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
}

model TaskCommentMention {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  commentId        String
  comment          TaskComment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  taskId           String
  task             Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  mentionedUserId  String
  mentionedUser    User         @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Restrict)
  requestedById    String
  requestedBy      User         @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  createdAt        DateTime     @default(now())

  @@index([organizationId])
  @@index([commentId])
  @@index([taskId])
  @@index([mentionedUserId])
  @@index([requestedById])
  @@index([createdAt])
}

model TaskNotificationLog {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           TaskNotificationType
  sentAt         DateTime             @default(now())
  createdAt      DateTime             @default(now())

  @@unique([taskId, userId, type])
  @@index([organizationId])
  @@index([taskId])
  @@index([userId])
  @@index([type])
  @@index([sentAt])
}

model Note {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  creatorId String
  creator   User       @relation(fields: [creatorId], references: [id], onDelete: Restrict)

  text   String
  source NoteSource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([creatorId])
}

model Budget {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  title       String
  description String?
  /// Ключевые слова для распознавания расходов в боте (через запятую)
  matchingKeywords String?

  initialAmount Decimal @db.Decimal(14, 2)
  spentAmount   Decimal @default(0) @db.Decimal(14, 2)
  currency      String  @default("RUB")

  status          BudgetStatus @default(ACTIVE)
  requiresReceipt Boolean      @default(false)

  archivedAt     DateTime?
  archivedById   String?
  archivedBy     User?     @relation("BudgetArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  archiveReason  String?

  createdById String
  createdBy   User   @relation("BudgetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses BudgetExpense[]
  access   BudgetAccess[]

  @@index([organizationId])
  @@index([projectId])
  @@index([createdById])
  @@index([archivedById])
  @@index([status])
}

model BudgetAccess {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgetId       String
  budget         Budget       @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("BudgetAccessUser", fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  createdById    String?
  createdBy      User?        @relation("BudgetAccessCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([budgetId, userId])
  @@index([organizationId])
  @@index([budgetId])
  @@index([userId])
  @@index([createdById])
}

model BudgetExpense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("ExpenseUser", fields: [userId], references: [id], onDelete: Restrict)

  amount      Decimal @db.Decimal(14, 2)
  currency    String  @default("RUB")
  description String?

  expenseDate DateTime

  status BudgetExpenseStatus @default(APPROVED)
  source ExpenseSource

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attachments BudgetExpenseAttachment[]

  @@index([organizationId])
  @@index([budgetId])
  @@index([userId])
}

model BudgetExpenseAttachment {
  id String @id @default(cuid())

  expenseId String
  expense   BudgetExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  storageKey        String?
  mimeType          String?
  originalFilename  String?
  telegramFileId    String?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([expenseId])
}

model Absence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   AbsenceType
  status AbsenceStatus @default(PENDING)

  startDate DateTime
  endDate   DateTime

  documentNumber String?
  comment        String?

  cancelledAt          DateTime?
  cancelledById      String?
  cancelledBy        User?   @relation("AbsenceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transfers         TaskTransfer[]
  notificationLogs  AbsenceNotificationLog[]

  @@index([organizationId])
  @@index([userId])
  @@index([cancelledById])
}

model AbsenceNotificationLog {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  absenceId      String
  absence        Absence                 @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  taskId         String
  task           Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           AbsenceNotificationType
  sentAt         DateTime                @default(now())
  createdAt      DateTime                @default(now())

  @@unique([absenceId, taskId, userId, type])
  @@index([organizationId])
  @@index([absenceId])
  @@index([taskId])
  @@index([userId])
  @@index([type])
  @@index([sentAt])
}

model Reminder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  title    String
  remindAt DateTime

  status ReminderStatus @default(SCHEDULED)
  sentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([taskId])
  @@index([remindAt])
}

model NotificationMessageBinding {
  id                    String                  @id @default(cuid())
  telegramChatId        String
  telegramMessageId     Int
  organizationId        String
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  taskId                String
  task                  Task                    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sourceCommentId       String?
  sourceCommentAuthorId String?
  notificationType      NotificationBindingType
  createdAt             DateTime                @default(now())
  expiresAt             DateTime?

  @@unique([telegramChatId, telegramMessageId])
  @@index([taskId])
  @@index([createdAt])
}
