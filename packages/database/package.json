{
  "name": "@neportal/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/prisma-generate.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/prisma-generate.mjs && tsc -p tsconfig.json --watch",
    "lint": "echo \"No linter configured for @neportal/database\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "aliases:backfill": "tsx scripts/backfill-user-aliases.ts",
    "projectId:nulls": "tsx scripts/check-null-project-id.ts",
    "projectId:backfill": "tsx scripts/backfill-task-budget-project-id.ts",
    "note:projectId:linked": "tsx scripts/check-note-project-id.ts",
    "note:projectId:nullify": "tsx scripts/export-and-nullify-note-project-id.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@neportal/shared": "workspace:*",
    "@prisma/client": "^6.8.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
