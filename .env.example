# Neportal — единственный файл окружения для локальной разработки: скопируйте в КОРЕНЬ репозитория как `.env`
# (не копируйте в apps/* или packages/database).

NODE_ENV=development

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Next.js (клиент): при необходимости fetch из браузера
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (matches docker-compose postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neportal

# Redis (matches docker-compose redis service)
REDIS_URL=redis://localhost:6379

# API auth
JWT_SECRET=change_me

# API
API_PORT=4000
# Локальное хранилище чеков, загруженных из Web (по умолчанию uploads/ в cwd API)
# UPLOAD_DIR=uploads
# MVP: привязка всех REST-запросов к одной организации (после seed по умолчанию slug neportal-demo)
# NEPORTAL_ORGANIZATION_ID=
NEPORTAL_ORG_SLUG=neportal-demo

# Telegram bot (grammY) — вызовы REST: используйте тот же API_URL, что и для web (по умолчанию http://localhost:4000)
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_WEBHOOK_URL=
BOT_MODE=polling
# Dev self-checks при старте бота (parse-ru-date, fix-ai-intent, resolve-users-by-hint)
BOT_DEV_SELF_CHECKS=false
# LLM-cleanup title для коротких deterministic create_task (true = всегда; false = только при шуме)
BOT_AI_CLEANUP_BASIC_TASKS=false
# Логи промптов YandexGPT при отказе/не-JSON (по умолчанию logs/yandex-gpt в cwd бота)
# BOT_YANDEX_PROMPT_LOG_DIR=logs/yandex-gpt
# Уведомления по задачам в Telegram (scheduler в процессе бота)
TASK_NOTIFICATION_SCHEDULER_ENABLED=true
TASK_NOTIFICATION_INTERVAL_MS=60000

# AI provider for bot intent parsing: yandex (default) | qwen
# AI_PROVIDER=yandex
# AI_PROVIDER_TIMEOUT_MS=30000
# AI_PROVIDER_MAX_RETRIES=1
# AI_PROVIDER_RETRY_BASE_DELAY_MS=500

# Qwen via Yandex Cloud AI Studio — only when AI_PROVIDER=qwen
# QWEN_API_KEY=<полный_secret_ключ_из_yc>
# QWEN_BASE_URL=https://ai.api.cloud.yandex.net/v1
# QWEN_AUTH_TYPE=api-key
# QWEN_MODEL=gpt://<FOLDER_ID>/<QWEN_MODEL_ID>/latest

# Optional cloud integrations
YANDEX_CLOUD_FOLDER_ID=change_me
# API key (Authorization: Api-Key) — приоритет над IAM token
YANDEX_GPT_API_KEY=change_me
# IAM token (Authorization: Bearer), если API key не задан
YANDEX_CLOUD_IAM_TOKEN=change_me
YANDEX_GPT_MODEL_URI=change_me

# Yandex SpeechKit STT (MVP foundation only; disabled by default)
YANDEX_SPEECHKIT_ENABLED=false
YANDEX_SPEECHKIT_API_KEY=
YANDEX_SPEECHKIT_FOLDER_ID=
YANDEX_SPEECHKIT_AUTH_TYPE=api-key
YANDEX_SPEECHKIT_LANGUAGE=ru-RU
YANDEX_SPEECHKIT_FORMAT=oggopus
YANDEX_SPEECHKIT_TIMEOUT_MS=30000
YANDEX_SPEECHKIT_MAX_DURATION_SEC=30
YANDEX_SPEECHKIT_MAX_FILE_SIZE_MB=1
YANDEX_SPEECHKIT_ASYNC_ENABLED=false
YANDEX_SPEECHKIT_ASYNC_MODEL=general
YANDEX_SPEECHKIT_ASYNC_POLL_INTERVAL_MS=2000
YANDEX_SPEECHKIT_ASYNC_TIMEOUT_MS=120000
YANDEX_SPEECHKIT_ASYNC_MAX_DURATION_SEC=600
YANDEX_SPEECHKIT_ASYNC_MAX_FILE_SIZE_MB=100
YANDEX_SPEECHKIT_ASYNC_DELETE_OBJECT=true
YANDEX_SPEECHKIT_OBJECT_STORAGE_BUCKET=
YANDEX_SPEECHKIT_OBJECT_STORAGE_PREFIX=speechkit/tmp/
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YANDEX_STORAGE_REGION=ru-central1
YANDEX_STORAGE_ACCESS_KEY_ID=
YANDEX_STORAGE_SECRET_ACCESS_KEY=
# Optional backward aliases:
# SPEECHKIT_API_KEY=
# SPEECHKIT_FOLDER_ID=

S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=change_me
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
