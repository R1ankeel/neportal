# Neportal — единственный файл окружения для локальной разработки: скопируйте в КОРЕНЬ репозитория как `.env`
# (не копируйте в apps/* или packages/database).

NODE_ENV=development

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
# Next.js (клиент): при необходимости fetch из браузера
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (matches docker-compose postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/neportal

# Redis (matches docker-compose redis service)
REDIS_URL=redis://localhost:6379

# API auth
JWT_SECRET=change_me

# API
API_PORT=4000
# Локальное хранилище чеков, загруженных из Web (по умолчанию uploads/ в cwd API)
# UPLOAD_DIR=uploads
# MVP: привязка всех REST-запросов к одной организации (после seed по умолчанию slug neportal-demo)
# NEPORTAL_ORGANIZATION_ID=
NEPORTAL_ORG_SLUG=neportal-demo

# Telegram bot (grammY) — вызовы REST: используйте тот же API_URL, что и для web (по умолчанию http://localhost:4000)
TELEGRAM_BOT_TOKEN=change_me
TELEGRAM_WEBHOOK_URL=
BOT_MODE=polling
# Dev self-checks при старте бота (parse-ru-date, fix-ai-intent, resolve-users-by-hint)
BOT_DEV_SELF_CHECKS=false
# LLM-cleanup title для коротких deterministic create_task (true = всегда; false = только при шуме)
BOT_AI_CLEANUP_BASIC_TASKS=false
# Логи промптов YandexGPT при отказе/не-JSON (по умолчанию logs/yandex-gpt в cwd бота)
# BOT_YANDEX_PROMPT_LOG_DIR=logs/yandex-gpt
# Уведомления по задачам в Telegram (scheduler в процессе бота)
TASK_NOTIFICATION_SCHEDULER_ENABLED=true
TASK_NOTIFICATION_INTERVAL_MS=60000

# Optional cloud integrations
YANDEX_CLOUD_FOLDER_ID=change_me
# API key (Authorization: Api-Key) — приоритет над IAM token
YANDEX_GPT_API_KEY=change_me
# IAM token (Authorization: Bearer), если API key не задан
YANDEX_CLOUD_IAM_TOKEN=change_me
YANDEX_GPT_MODEL_URI=change_me
YANDEX_SPEECHKIT_API_KEY=change_me

S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=change_me
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me
